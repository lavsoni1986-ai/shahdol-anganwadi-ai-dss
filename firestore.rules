rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backend-only architecture: the Firebase Admin SDK bypasses these rules.
    // All Firestore access is through the FastAPI backend using the Admin SDK.
    // No browser/client should read or write Firestore directly.
    // Deny all client access — the Admin SDK is the only authorized caller.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}