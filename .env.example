# =====================================================================
# BharatOS - District Shahdol Anganwadi Digital Verification MVP
# Environment Configuration Template
# Copy this file to `.env` and fill in your actual values.
# DO NOT commit `.env` to version control.
# =====================================================================

# --- Application Settings ---
APP_NAME="Shahdol Anganwadi Digital Verification System"
APP_VERSION="1.0.0"
APP_PUBLIC_URL=https://api.bharatosdemo24.com
DEBUG=True
LOG_LEVEL=INFO

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000

# --- Database Configuration ---
# For MVP/Development: SQLite (no separate server needed)
DATABASE_URL=sqlite:///./shahdol_anganwadi.db

# For Production: PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/shahdol_anganwadi_db

# --- Meta WhatsApp Cloud API Credentials ---
# Obtain from: https://developers.facebook.com/apps/<your-app-id>/whatsapp-business/wa-dev-console/
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_VERSION=v19.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# --- Security ---
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production

# --- Pilot Center Configuration (Shahdol Day 1 Pilot) ---
PILOT_AWC_ID=AWC-SHA-1042
PILOT_CENTER_NAME=रामपुर
PILOT_BLOCK_NAME=सोहागपुर
PILOT_DISTRICT=Shahdol

# --- AI Keys (Gemini primary, Groq fallback) ---
GEMINI_API_KEY=your_gemini_api_key_from_ai_studio_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here

# --- Vision Provider Router ---
VISION_ROUTER_ENABLED=true
VISION_PROVIDER_PRIMARY=gemini
VISION_PROVIDER_FALLBACK=gemma
